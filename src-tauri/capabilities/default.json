{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the main window",
  "windows": ["main", "widget"],
  "permissions": [
    "core:default",
    "autostart:default",
    "global-shortcut:default",
    "updater:default",
    "process:default",
    "process:allow-restart"
  ]
}
