{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Usage",
  "identifier": "io.github.aiusage.tracker",
  "version": "1.1.1",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "widget",
        "title": "AI Usage",
        "width": 544,
        "height": 304,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "publisher": "AI Usage Project",
    "copyright": "© 2026 AI Usage Project",
    "category": "Utility",
    "shortDescription": "Local-only usage tracker for Claude Code, Antigravity, and Codex.",
    "longDescription": "A frameless always-on-top widget that shows tokens, tasks, cost, and quota windows across your AI tools. Runs entirely on your machine.",
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBBREYzQUYwMjQ0Q0U5MkEKUldRcTZVd2s4RHJmQ216dmlMVTBvU0VCUm9VQi9LWHlPT2RFQ20vREVDbGNqNy9TNWpzZFdDRjMK",
      "endpoints": [
        "https://github.com/movindu477/ai-usage/releases/latest/download/latest.json"
      ]
    }
  }
}
